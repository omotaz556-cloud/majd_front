# رابط الباك إند - غيّريه في بيئة الإنتاج
VITE_API_URL=http://localhost:5000/api

# ملحوظة: مفيش أي متغير VITE_ADS_* أو VITE_GOOGLE_* هنا، ولا داعي له.
# الفرونت إند بيجيب كل إعدادات الإعلانات (المزوّد، test mode، معرّفات
# Google Ad Manager) تلقائياً من الباك إند وقت الإقلاع (GET /api/ads/config)،
# ونفس الأمر بالنسبة لـ payment_provider (GET /api/config). مكان التحكم
# الوحيد في كل القيم دي هو backend/.env - مفيش أي تعديل مطلوب هنا خالص.
